// FHDL 데모 프로젝트
// 단순 펌프 → 배관 → 터미널 구조

system main {
    unit_system = METRIC;
    fluid = water;
    temp = 20;
    altitude = 0m;
    friction_model = DW;
}

constraint {
    velocity_min = 0.3m/s;
    velocity_max = 2.5m/s;
    safety_factor_head = 1.1;
}

// 공급 탱크 (고도 10m)
tank reservoir {
    elevation = 10m;
    volume = 50m3;
    level_max = 1.5m;
    x = 0;
    y = 0;
}

// 공급 펌프 (양정 auto → 사양 선정 대상)
pump p1 {
    elevation = 8m;
    x = 5;
    y = 0;
}

// 분기점
junction j1 {
    elevation = 5m;
    x = 50;
    y = 0;
}

// 터미널 장치 A (스프링클러)
terminal sprinkler_A {
    elevation = 3m;
    required_q = 80lpm;
    required_p = 0.1MPa;
    x = 100;
    y = 30;
}

// 터미널 장치 B (노즐)
terminal nozzle_B {
    elevation = 2m;
    required_q = 60lpm;
    required_p = 0.08MPa;
    x = 100;
    y = -30;
}

// 배관 정의
// 배관 경로: via = 경유점 (x, y, z) m — 꺾이는 곳마다 엘보 K 자동 가산, length 생략 시 경로 길이
// 부속 위치: name@거리(m, 배관 시작점 기준) 또는 name@비율(%)
pipe suction {
    start = reservoir;
    end = p1;
    via = [(0, 0, 8)];
    diameter = auto;
    material = Steel;
    fittings = [valve_gate@1m, strainer_y@4m];
}

pipe main_pipe {
    start = p1;
    end = j1;
    via = [(45, 0, 8), (45, 0, 5)];
    diameter = auto;
    material = Steel;
    fittings = [valve_check@3m, valve_gate@6m, pressure_gauge@10m];
}

pipe branch_A {
    start = j1;
    end = sprinkler_A;
    via = [(50, 30, 5), (100, 30, 5)];
    diameter = auto;
    material = Steel;
    fittings = [valve_ball@2m, flow_meter@50%];
}

pipe branch_B {
    start = j1;
    end = nozzle_B;
    via = [(50, -30, 5), (100, -30, 5)];
    diameter = auto;
    material = Steel;
    fittings = [valve_globe@2m];
}

// 연결 정의
connect reservoir -> p1 -> j1;
connect j1 -> sprinkler_A;
connect j1 -> nozzle_B;
